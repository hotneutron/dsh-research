{
  "name": "dsh-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project-owned research contracts for DSH and superagent",
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/contracts.md",
    "docs/compatibility.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "m1:smoke": "tsx scripts/m1-smoke.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@types/node": "22.20.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
