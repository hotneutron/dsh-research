{
  "name": "dsh-research",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Project-owned research contracts for DSH and superagent",
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-qualification-lock.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "m1:smoke": "tsx scripts/m1-smoke.ts",
    "m2:smoke": "node examples/synthetic-cpu/run.mjs",
    "m3:smoke": "node examples/synthetic-cpu/automatic.mjs",
    "m4:smoke": "node examples/synthetic-cpu/faults.mjs",
    "m6:smoke": "node examples/synthetic-cpu/continuity.mjs",
    "gpu:smoke": "node examples/gpu/run.mjs",
    "m1:integrated": "node scripts/m1-integrated.mjs",
    "m1:default": "python3 examples/superagent/default-runtime.py",
    "m2:default": "python3 examples/superagent/default-runtime.py --research",
    "m3:default": "python3 examples/superagent/default-runtime.py --automatic"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@types/node": "22.20.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  }
}
